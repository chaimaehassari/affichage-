{
  "name": "dyndisplay-windows-player",
  "version": "1.0.0",
  "description": "DynDisplay Player Windows - lecteur d'affichage kiosque Electron (canal de sortie Windows, même source de données que le player Android existant).",
  "main": "electron/main.js",
  "author": "DynDisplay",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k \"vite\" \"wait-on tcp:5174 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build": "vite build",
    "test:license": "node test/licenseVerify.test.js",
    "start": "electron .",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir",
    "pack": "vite build && electron-builder --win"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.3.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.dyndisplay.player",
    "productName": "DynDisplay Player",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DynDisplay Player",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "DynDisplay-Player-${version}-portable.${ext}"
    },
    "artifactName": "DynDisplay-Player-${version}.${ext}"
  }
}