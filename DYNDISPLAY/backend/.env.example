# PostgreSQL (COPY de ce fichier vers .env puis remplir les vraies valeurs)
# IMPORTANT : ne jamais committer les vraies valeurs (mots de passe, secrets).
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=DYNDISPLAY
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# SFTP
SFTP_HOST=127.0.0.1
SFTP_PORT=22
SFTP_USERNAME=changeme
SFTP_PASSWORD=changeme
SFTP_ROOT_PATH=/C:/DYNDISPLAY-SFTP

# JWT — OBLIGATOIRE : le serveur refuse de démarrer si cette variable est
# absente/vide. Générer une valeur forte (ex. `openssl rand -hex 32`) et la
# placer uniquement dans .env. Ne jamais committer la vraie valeur.
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Suffixe secret du code d'accès Admin suprême (le code saisi est JJMMAAAA + ce suffixe).
# OBLIGATOIRE : le serveur refuse de démarrer si cette variable est absente/vide.
# La vraie valeur (X7K9, ou une valeur plus longue si le propriétaire décide de la
# rallonger) ne doit exister QUE dans le vrai .env du serveur, jamais commitée,
# et ne doit jamais être communiquée par email en clair.
SUPREME_ADMIN_SECRET=CHANGE_MOI_EN_PROD

# CORS - origines autorisées à appeler l'API (séparées par des virgules)
# Dev : http://localhost:5173 (Vite)
# Production : https://votre-domaine.example
CORS_ORIGINS=http://localhost:5173

# Chemin absolu du frontend React compilé (frontend/dist) pour que FastAPI le serve.
# Vide = API seule.
UI_DIST_PATH=

# Fuseau horaire de l'application (vide = heure locale du serveur)
APP_TIMEZONE=Atlantic/Casablanca

# Secret HMAC pour les codes de licence (doit être identique côté app Android — local.properties → license.secret —
# et outil Python de référence). NE PAS committer la vraie valeur. Ex. : openssl rand -hex 32
LICENSE_SECRET=REMPLACER-PAR-LE-VRAI-SECRET